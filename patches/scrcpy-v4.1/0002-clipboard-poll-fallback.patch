+    private void sendClipboardIfChanged() {
+        String text = Device.getClipboardText();
+        if (text == null) {
+            return;
+        }
+        String previous = lastSyncedClipboard.getAndSet(text);
+        if (text.equals(previous)) {
+            return;
+        }
+        sender.send(DeviceMessage.createClipboard(text));
