+    private void startClipboardPoll() {
+        // On Android 17 the primary clip listener registered by the shell user did not fire in testing. The shell user holds
+        // READ_CLIPBOARD_IN_BACKGROUND, so reading the clipboard once per second is a reliable fallback.
+        lastSyncedClipboard.set(Device.getClipboardText());
+        Thread thread = new Thread(() -> {
+            while (!Thread.currentThread().isInterrupted()) {
+                try {
+                    Thread.sleep(1000);
+                } catch (InterruptedException e) {
+                    return;
+                }
+                if (!isSettingClipboard.get()) {
+                    try {
+                        sendClipboardIfChanged();
+                    } catch (RuntimeException e) {
+                        Ln.w("Clipboard poll failed", e);
+                    }
+                }
+            }
+        }, "clipboard-poll");
+        thread.setDaemon(true);
+        thread.start();
+    }
