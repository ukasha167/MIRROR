+    private static Thread startKeepAlive(int displayId) {
+        // The display has its own power group (no DEVICE_DISPLAY_GROUP flag). While the keyguard shows, that group sleeps after ~10 s
+        // without user activity. The shell user holds DEVICE_POWER, so it can report activity for this display every 4 s.
+        Thread thread = new Thread(() -> {
+            while (!Thread.currentThread().isInterrupted()) {
+                try {
+                    ServiceManager.getPowerManager().userActivity(displayId);
+                } catch (RuntimeException e) {
+                    Ln.w("Desk mode keep-alive failed for display " + displayId + ", stopping", e);
+                    return;
+                }
+                try {
+                    Thread.sleep(4000);
+                } catch (InterruptedException e) {
+                    return;
+                }
+            }
+        }, "vd-keepalive");
+        thread.setDaemon(true);
+        thread.start();
+        return thread;
+    }
+
+    private void stopKeepAlive() {
+        if (keepAliveThread != null) {
+            keepAliveThread.interrupt();
+            keepAliveThread = null;
+        }
+    }
